# Fit issf - here I'm fitting a simple model using base amt function fit_issf
# you can adapt this to fit more complex models (e.g., using glmmTMB) as you wish
issf <- fit_issf(data_amt,
case_ ~
# Habitat
treeCover + Dist2mounds + Dist2rivers +
# Movement
sl_ + ta_ +
# Strata
strata(step_id_), model = TRUE)
# Set up for simulation
# First generate a redistribution kernel
start <- make_start(data_amt[1,]) # This is the starting location (we could sample it randomly from within the area we want to)
#set the turning angle to 0 if the first is na_ (typical if the first in a burst)
start$ta_ <- ifelse(is.na(start$ta_), 0, start$ta_)
k1 <- redistribution_kernel(issf,
map = habCovs,
start = start,
fun = function(xy, map) {
extract_covariates(xy, map, where = "end")
},
n.control = 1000,
landscape = "continuous",
tolerance.outside = 0.2)
# Simulate a path for 30 steps (to see if it works before running the large process)
simPath <- simulate_path(k1, n.steps = 30)
k1 <- redistribution_kernel(issf,
map = habCovs,
start = start,
fun = function(xy, map) {
extract_covariates(xy, map, where = "end")
},
n.control = 1000,
landscape = "continuous",
tolerance.outside = 0.9)
# Simulate a path for 30 steps (to see if it works before running the large process)
simPath <- simulate_path(k1, n.steps = 30)
# Now simulate a path of length 30 for 50 times. This will lead a transient UD. For a steady state UD, either increase `n` or choose many more random starting points.
n <- 50
p1 <- replicate(n, simulate_path(k1, n.steps = 30), simplify = FALSE) # Takes about 2 min
uds <- lapply(c(5, 30), function(i) {
tibble(
rep = 1:n,
path = map(p1, ~ dplyr::slice(.x, i))
) |> unnest(cols = path) |> filter(!is.na(x_)) |>
make_track(x_, y_) |> hr_kde(trast = treeCover)
})
# Plot some UDs as examples
terra::plot(hr_ud(uds[[1]]))
terra::plot(hr_ud(uds[[2]]))
# Plot trajectories as examples
plot(p1[[1]]$y_ ~ p1[[1]]$x_)
plot(p1[[2]]$y_ ~ p1[[2]]$x_)
proj <- "EPSG:2736"
traj1 <- p1[[1]]
traj1 <- st_as_sf(traj1, coords=c("x_","y_"), dim="XY", crs=proj)
plot(traj1$geometry)
mapview(traj1)
# Plot UD and track together
track_spatvector <- terra::vect(traj1)
terra::plot(hr_ud(uds[[1]]))
terra::lines(track_spatvector)
terra::points(track_spatvector)
