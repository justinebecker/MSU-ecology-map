forest
data("deer")
forest <- get_sh_forest() # this needed because of terra
# Prepare data
data_ssf <- deer |>
steps_by_burst() |>
random_steps(n_control = 15) |>
extract_covariates(forest, where = "both")
# Fit model
m1 <- data_ssf |>
fit_clogit(case_ ~ forest_end +  forest_start:cos(ta_) +
forest_start:sl_ + strata(step_id_))
# First generate a redistribution kernel
start <- make_start(deer[1, ]) # This is the starting location (we could sample it randomly from within the area we want to)
k1 <- redistribution_kernel(m1, map = forest, start = start)
# Simulate a path for 30 steps (to see if it works before running the large process)
simPath <- simulate_path(k1, n.steps = 30)
# Now simulate a path of length 30 for 50 times. This will lead a transient UD. For a steady state UD, either increase `n` or choose many more random starting points.
n <- 50
p1 <- replicate(n, simulate_path(k1, n.steps = 30), simplify = FALSE) # Takes about 2 min
uds <- lapply(c(5, 30), function(i) {
tibble(
rep = 1:n,
path = map(p1, ~ dplyr::slice(.x, i))
) |> unnest(cols = path) |> filter(!is.na(x_)) |>
make_track(x_, y_) |> hr_kde(trast = forest)
})
# Plot some UDs as examples
terra::plot(hr_ud(uds[[1]]))
terra::plot(hr_ud(uds[[2]]))
# Plot trajectories as examples
plot(p1[[1]]$y_ ~ p1[[1]]$x_)
plot(p1[[2]]$y_ ~ p1[[2]]$x_)
proj <- "+proj=laea +lat_0=52 +lon_0=10 +x_0=4321000 +y_0=3210000 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=m +no_defs"
traj1 <- p1[[1]]
traj1 <- st_as_sf(traj1, coords=c("x_","y_"), dim="XY", crs=proj)
plot(traj1$geometry)
# Plot UD and track together
track_spatvector <- terra::vect(traj1)
terra::plot(hr_ud(uds[[1]]))
terra::lines(track_spatvector)
terra::points(track_spatvector)
traj1 <- p1[[1]]
# Plot trajectories as examples
plot(p1[[1]]$y_ ~ p1[[1]]$x_)
plot(p1[[2]]$y_ ~ p1[[2]]$x_)
traj1 <- st_as_sf(traj1, coords=c("x_","y_"), dim="XY", crs=proj)
traj1
traj1 <- st_as_sf(traj1, coords=c("x_","y_"), dim="XY", crs=proj, na.rm=T)
# Plot UD and track together
track_spatvector <- terra::vect(traj1)
