# Fit issf - here I'm fitting a simple model using base amt function fit_issf
# you can adapt this to fit more complex models (e.g., using glmmTMB) as you wish
issf <- fit_issf(data_amt,
case_ ~
# Habitat
treeCover +
# Movement
sl_ + log_sl_ + cos_ta_ +
# Strata
strata(step_id_), model = TRUE)
# Set up for simulation
# First generate a redistribution kernel
start <- make_start(c(mean(data_amt$x1_), mean(data_amt$y1_))) # This is the starting location (we could sample it randomly from within the area we want to)
k1 <- redistribution_kernel(issf, map = treeCover, start = start)
# Stack them
habCovs <- c(treeCover, Dist2mounds, Dist2Rivers)
# Stack them
habCovs <- c(treeCover, Dist2mounds, Dist2rivers)
habCovs
names(habCovs)
# Rename all layers at once
names(habCovs) <- c("treeCover", "Dist2mounds", "Dist2rivers")
# Format data for use with amt
data_amt <- data %>%
filter(case==1) %>%
make_track(.x=x_orig, .y=y_orig, .t=timestamp, id=id_yr_seas, crs="EPSG:2736") %>% # update CRS to match your data!
steps() %>%
random_steps(n_control = 15) %>%
# Attach covariates
extract_covariates(habCovs) %>%
# Additional movement parameters
mutate(log_sl_ = log(sl_),
cos_ta_ = cos(ta_)) %>%
# Get rid of any NAs (sometimes available steps fall outside of raster)
na.omit()
head(data_amt)
